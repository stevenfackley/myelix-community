<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Myelix.Core.Contracts" Version="1.0.0" />
    <PackageReference Include="Myelix.Core.Runtime" Version="1.0.0" />
    <!--
      Microsoft.ML.OnnxRuntime: cross-platform ONNX inference.
      The Android target should instead reference Microsoft.ML.OnnxRuntime.Managed
      together with the NNAPI execution provider for hardware acceleration.
      For now this single package covers desktop and simulator targets.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
  </ItemGroup>

</Project>
