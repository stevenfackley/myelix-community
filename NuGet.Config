<?xml version="1.0" encoding="utf-8"?>
<!--
  The Myelix.Core.* libraries live in the private myelix-core repo and are
  published to the GitHub Packages NuGet feed for the stevenfackley account.
  That feed requires authentication even for read, so restore needs credentials.

  Credentials are NEVER stored in this file. The values below are NuGet
  environment-variable placeholders that are expanded at restore time:

    NUGET_USER        the GitHub username that owns the feed (stevenfackley)
    NUGET_AUTH_TOKEN  a classic PAT with the read:packages scope

  In CI these come from the MYELIX_PACKAGES_TOKEN repository secret; see
  .github/workflows/main.yml. For local development see "Restoring packages"
  in README.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/stevenfackley/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Only the Myelix.* packages come from the private feed; everything else
       must come from nuget.org. This keeps the authenticated feed out of the
       restore path for public packages and blocks dependency confusion. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Myelix.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <github>
      <add key="Username" value="%NUGET_USER%" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
